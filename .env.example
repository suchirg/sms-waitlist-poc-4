# Twilio Configuration
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/sms_waitlist
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sms_waitlist
DB_USER=postgres
DB_PASSWORD=your_password_here

# Server Configuration
NODE_ENV=development
PORT=3000
SERVER_URL=http://localhost:3000

# Restaurant Configuration
RESTAURANT_ID=rest_001
RESTAURANT_NAME=Test Cafe
RESTAURANT_PHONE=+1234567890
RESTAURANT_API_KEY=your_secure_api_key_here_min_32_chars_long

# Analytics Configuration
ANALYTICS_RESET_TIME=11:00
ANALYTICS_CACHE_TTL=30

# Auto No-Show Configuration
NO_SHOW_TIMEOUT_MINUTES=5
NO_SHOW_CHECK_INTERVAL_SECONDS=30

# WebSocket Configuration
ENABLE_WEBSOCKET=true
WEBSOCKET_PORT=3001

# Deployment Configuration
ENVIRONMENT=development
LOG_LEVEL=debug
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100